generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  UNDER_NEGOTIATION
  REVISED
  ACCEPTED
  REJECTED
  INVOICE_GENERATED
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  DELIVERED
  CLOSED
}

enum RfqChannel {
  WHATSAPP
  EMAIL
  WEB_FORM
  MARKETPLACE
  MANUAL
}

enum RfqStatus {
  NEW
  NEEDS_REVIEW
  PARSED
  QUOTED
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum VendorPreferredChannel {
  EMAIL
  WHATSAPP
}

enum VendorOutreachStatus {
  PENDING
  SENT
  REPLIED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String   @default("")
  unit        String   @default("pcs")
  basePrice   Decimal  @db.Decimal(12, 2)
  offerPrice  Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @default(18) @db.Decimal(5, 2)
  taxCategory String   @default("GST18")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems QuoteLineItem[]

  @@index([name])
  @@index([active])
}

model Rfq {
  id              String     @id @default(cuid())
  channel         RfqChannel
  sourceRef       String     @default("") // message id / thread id
  subject         String     @default("")
  rawText         String     @default("")
  rawAttachments  Json       @default("[]") // [{ name, url?, contentType? }]
  customerName    String     @default("")
  customerPhone   String     @default("")
  customerEmail   String     @default("")
  customerCompany String     @default("")
  status          RfqStatus  @default(NEW)
  parsedCategory  String?
  parsedSpecs     Json? // structured extraction from AI
  parseConfidence Float?
  parseError      String?
  marketplacePrices Json? // cached Amazon/Flipkart/IndiaMART snapshot
  marketplaceQuery  String? // search query used for the snapshot
  marketplaceFetchedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  messages           RfqMessage[]
  quotes             Quote[]
  vendorPriceHistory VendorProductHistory[]
  vendorOutreaches   VendorOutreach[]

  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([sourceRef])
}

model RfqMessage {
  id        String           @id @default(cuid())
  rfqId     String
  direction MessageDirection
  channel   RfqChannel
  body      String           @default("")
  meta      Json             @default("{}") // provider ids, headers, etc.
  createdAt DateTime         @default(now())

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)
  version     Int         @default(1)
  rfqId       String?

  buyerName    String @default("")
  buyerCompany String @default("")
  buyerEmail   String @default("")
  buyerPhone   String @default("")
  buyerState   String @default("")
  buyerAddress String @default("")

  withGst         Boolean @default(true)
  gstMode         String  @default("AUTO") // AUTO | CGST_SGST | IGST
  subtotal        Decimal @default(0) @db.Decimal(14, 2)
  gstAmount       Decimal @default(0) @db.Decimal(14, 2)
  cgstAmount      Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount      Decimal @default(0) @db.Decimal(14, 2)
  igstAmount      Decimal @default(0) @db.Decimal(14, 2)
  otherTaxAmount  Decimal @default(0) @db.Decimal(14, 2)
  otherTaxLabel   String  @default("")
  deliveryCharge  Decimal @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  grandTotal      Decimal @default(0) @db.Decimal(14, 2)

  /// Flags for fields the user manually overrode so recalc does not clobber them
  manualOverrides Json @default("{}")

  notes      String    @default("")
  validUntil DateTime?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  lineItems QuoteLineItem[]
  rfq       Rfq?            @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([rfqId])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  description String  @default("")
  qty         Decimal @default(1) @db.Decimal(12, 3)
  unit        String  @default("pcs")
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal @default(0) @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

model Vendor {
  id               String                 @id @default(cuid())
  name             String
  phone            String?
  email            String?
  whatsappId       String?
  preferredChannel VendorPreferredChannel @default(EMAIL)
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  categories     VendorCategory[]
  productHistory VendorProductHistory[]
  outreaches     VendorOutreach[]

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([active])
}

model VendorCategory {
  id          String @id @default(cuid())
  vendorId    String
  category    String
  subcategory String @default("")
  keywords    Json   @default("[]")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, category, subcategory])
  @@index([category])
  @@index([vendorId])
}

model VendorProductHistory {
  id           String   @id @default(cuid())
  vendorId     String
  productKey   String
  lastPrice    Decimal  @db.Decimal(14, 2)
  lastQuotedAt DateTime
  sourceRfqId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sourceRfq Rfq?   @relation(fields: [sourceRfqId], references: [id], onDelete: SetNull)

  @@unique([vendorId, productKey])
  @@index([productKey])
  @@index([vendorId])
  @@index([sourceRfqId])
  @@index([lastQuotedAt])
}

model VendorOutreach {
  id              String               @id @default(cuid())
  rfqId           String
  vendorId        String
  productKey      String               @default("")
  threadRef       String               @unique
  status          VendorOutreachStatus @default(PENDING)
  outboundSubject String               @default("")
  outboundBody    String               @default("")
  outboundMsgId   String               @default("")
  replyText       String               @default("")
  replyMsgId      String               @default("")
  quotedPrice     Decimal?             @db.Decimal(14, 2)
  sentAt          DateTime?
  repliedAt       DateTime?
  errorMessage    String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  rfq    Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
  @@index([outboundMsgId])
  @@index([status])
}

model AppState {
  key       String   @id
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id                String        @id @default(cuid())
  organisationId    String
  gstRegistrationId String
  partyId           String
  proformaInvoiceId String?
  number            String
  status            InvoiceStatus @default(DRAFT)
  issueDate         DateTime      @db.Date
  dueDate           DateTime?     @db.Date
  placeOfSupplyCode String
  reverseCharge     Boolean       @default(false)
  currency          String        @default("INR")
  subtotal          Decimal       @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(18, 2)
  roundOff          Decimal       @default(0) @db.Decimal(18, 2)
  total             Decimal       @default(0) @db.Decimal(18, 2)
  balanceDue        Decimal       @default(0) @db.Decimal(18, 2)
  billingSnapshot   Json
  shippingSnapshot  Json?
  immutableSnapshot Json?
  issuedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  gstRegistration    GSTRegistration     @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)
  party              Party               @relation(fields: [partyId], references: [id], onDelete: Restrict)
  proformaInvoice    ProformaInvoice?    @relation(fields: [proformaInvoiceId], references: [id], onDelete: SetNull)
  lines              InvoiceLine[]
  notes              CreditDebitNote[]
  stockMovements     StockMovement[]
  paymentAllocations PaymentAllocation[]
  eInvoiceRecords    EInvoiceRecord[]
  eWayBillRecords    EWayBillRecord[]
  gstReconciliations GstReconciliation[]

  @@unique([gstRegistrationId, number])
  @@index([organisationId, issueDate])
  @@index([partyId, status, dueDate])
}

model InvoiceLine {

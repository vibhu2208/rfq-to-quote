model StockMovement {
  id                 String            @id @default(cuid())
  gstRegistrationId  String
  warehouseId        String
  productId          String
  invoiceId          String?
  type               StockMovementType
  occurredAt         DateTime
  quantity           Decimal           @db.Decimal(18, 3)
  unitCost           Decimal           @default(0) @db.Decimal(18, 4)
  value              Decimal           @default(0) @db.Decimal(18, 2)
  runningQuantity    Decimal?          @db.Decimal(18, 3)
  runningAverageCost Decimal?          @db.Decimal(18, 4)
  sourceType         String
  sourceId           String
  idempotencyKey     String            @unique
  metadata           Json              @default("{}")
  reversedById       String?           @unique
  createdAt          DateTime          @default(now())

  gstRegistration GSTRegistration           @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)
  warehouse       Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoice         Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  reversedBy      StockMovement?            @relation("MovementReversal", fields: [reversedById], references: [id], onDelete: Restrict)
  reverses        StockMovement?            @relation("MovementReversal")
  valuationLayers InventoryValuationLayer[]

  @@index([warehouseId, productId, occurredAt])
  @@index([sourceType, sourceId])
}

model StockBalance {
  id               String   @id @default(cuid())
  warehouseId      String
  productId        String
  quantityOnHand   Decimal  @default(0) @db.Decimal(18, 3)
  quantityReserved Decimal  @default(0) @db.Decimal(18, 3)
  averageCost      Decimal  @default(0) @db.Decimal(18, 4)
  inventoryValue   Decimal  @default(0) @db.Decimal(18, 2)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId])
}

model InventoryValuationLayer {
  id             String                   @id @default(cuid())
  warehouseId    String
  productId      String
  asOf           DateTime
  movementId     String?
  quantity       Decimal                  @db.Decimal(18, 3)
  averageCost    Decimal                  @db.Decimal(18, 4)
  inventoryValue Decimal                  @db.Decimal(18, 2)
  policy         InventoryValuationMethod @default(WEIGHTED_AVERAGE)
  policyMetadata Json                     @default("{}")
  createdAt      DateTime                 @default(now())

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  movement  StockMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([warehouseId, productId, asOf])
  @@index([movementId])
}

model ChartOfAccount {
  id             String      @id @default(cuid())
  organisationId String
  legalEntityId  String
  parentId       String?
  code           String
  name           String
  type           AccountType
  systemKey      String?
  active         Boolean     @default(true)
  allowPosting   Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  legalEntity     LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  parent          ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        ChartOfAccount[] @relation("AccountHierarchy")
  journalLines    JournalLine[]
  paymentAccounts Payment[]

  @@unique([legalEntityId, code])
  @@unique([legalEntityId, systemKey])
  @@index([organisationId, type, active])
}

model JournalEntry {
  id              String        @id @default(cuid())
  organisationId  String
  legalEntityId   String
  fiscalYearId    String
  fiscalPeriodId  String
  number          String
  status          JournalStatus @default(DRAFT)
  entryDate       DateTime      @db.Date
  sourceType      String
  sourceId        String?
  narration       String        @default("")
  idempotencyKey  String?       @unique
  postedAt        DateTime?
  reversedEntryId String?       @unique
  createdAt       DateTime      @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  legalEntity   LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  fiscalYear    FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  fiscalPeriod  FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  lines         JournalLine[]
  reversedEntry JournalEntry? @relation("JournalReversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversalEntry JournalEntry? @relation("JournalReversal")

  @@unique([legalEntityId, number])
  @@index([organisationId, entryDate, status])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  lineNumber     Int
  accountId      String
  partyId        String?
  description    String   @default("")
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  dimensions     Json     @default("{}")
  createdAt      DateTime @default(now())

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  party        Party?         @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
  @@index([partyId])
}

model Payment {
  id             String           @id @default(cuid())
  organisationId String
  partyId        String?
  accountId      String
  number         String
  direction      PaymentDirection
  method         PaymentMethod
  status         PaymentStatus    @default(DRAFT)
  paymentDate    DateTime         @db.Date
  amount         Decimal          @db.Decimal(18, 2)
  currency       String           @default("INR")
  reference      String?
  instrumentDate DateTime?        @db.Date
  clearedAt      DateTime?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  party        Party?              @relation(fields: [partyId], references: [id], onDelete: SetNull)
  account      ChartOfAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]

  @@unique([organisationId, number])
  @@index([partyId, paymentDate])
}

model PaymentAllocation {
  id          String    @id @default(cuid())
  paymentId   String
  invoiceId   String
  amount      Decimal   @db.Decimal(18, 2)
  allocatedAt DateTime  @default(now())
  reversedAt  DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model GstReturn {
  id                String          @id @default(cuid())
  gstRegistrationId String
  type              GstReturnType
  period            String
  status            GstRecordStatus @default(DRAFT)
  payload           Json            @default("{}")
  summary           Json            @default("{}")
  preparedAt        DateTime?
  filedAt           DateTime?
  arn               String?
  version           Int             @default(1)
  supersedesId      String?         @unique
  createdAt         DateTime        @default(now())

  gstRegistration GSTRegistration     @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)
  submissions     GstSubmission[]
  supersedes      GstReturn?          @relation("ReturnSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy    GstReturn?          @relation("ReturnSupersession")
  reconciliations GstReconciliation[]

  @@unique([gstRegistrationId, type, period, version])
  @@index([gstRegistrationId, period, status])
}

model GstReconciliation {

  @@unique([organisationId, code])
  @@index([gstRegistrationId, active])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organisationId String
  actorUserId    String?
  occurredAt     DateTime @default(now())
  action         String
  entityType     String
  entityId       String
  correlationId  String?
  ipAddress      String?
  userAgent      String?
  before         Json?
  after          Json?
  metadata       Json     @default("{}")
  hash           String?
  previousHash   String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, occurredAt])
  @@index([entityType, entityId])
  @@index([correlationId])
}

model SourceDocument {
  id             String             @id @default(cuid())
  organisationId String
  type           SourceDocumentType
  externalRef    String?
  fileName       String
  contentType    String?
  storageKey     String
  checksum       String
  receivedAt     DateTime           @default(now())
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  extractions  DocumentExtraction[]
  drafts       TransactionDraft[]

  @@unique([organisationId, checksum])
  @@index([organisationId, receivedAt])
}

model DocumentExtraction {
  id               String           @id @default(cuid())
  sourceDocumentId String
  status           ExtractionStatus @default(PENDING)
  engine           String?
  engineVersion    String?
  extractedData    Json?
  confidence       Decimal?         @db.Decimal(5, 4)
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())

  sourceDocument SourceDocument     @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  drafts         TransactionDraft[]

  @@index([sourceDocumentId, createdAt])
  @@index([status])
}

model TransactionDraft {
  id                   String       @id @default(cuid())
  organisationId       String
  sourceDocumentId     String?
  documentExtractionId String?
  partyId              String?
  type                 DocumentType
  status               DraftStatus  @default(DRAFT)
  documentDate         DateTime?    @db.Date
  payload              Json         @default("{}")
  revision             Int          @default(1)
  validatedAt          DateTime?
  postedAt             DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organisation       Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  sourceDocument     SourceDocument?        @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  documentExtraction DocumentExtraction?    @relation(fields: [documentExtractionId], references: [id], onDelete: SetNull)
  party              Party?                 @relation(fields: [partyId], references: [id], onDelete: SetNull)
  lines              TransactionDraftLine[]
  validations        DraftValidation[]

  @@index([organisationId, status, createdAt])
  @@index([sourceDocumentId])
}

model TransactionDraftLine {
  id                 String   @id @default(cuid())
  transactionDraftId String
  lineNumber         Int
  productId          String?
  description        String
  hsnCode            String?
  uqc                UqcCode?
  quantity           Decimal  @default(0) @db.Decimal(18, 3)
  unitPrice          Decimal  @default(0) @db.Decimal(18, 4)
  taxRate            Decimal  @default(0) @db.Decimal(5, 2)
  taxableValue       Decimal  @default(0) @db.Decimal(18, 2)
  payload            Json     @default("{}")

  draft   TransactionDraft @relation(fields: [transactionDraftId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([transactionDraftId, lineNumber])
  @@index([productId])
}

model DraftValidation {
  id                 String             @id @default(cuid())
  transactionDraftId String
  severity           ValidationSeverity
  code               String
  fieldPath          String?
  message            String
  details            Json               @default("{}")
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())

  draft TransactionDraft @relation(fields: [transactionDraftId], references: [id], onDelete: Cascade)

  @@index([transactionDraftId, severity])
}

model ProformaInvoice {
  id                String        @id @default(cuid())
  organisationId    String
  gstRegistrationId String
  partyId           String
  quoteId           String?
  number            String
  status            InvoiceStatus @default(DRAFT)
  issueDate         DateTime      @db.Date
  validUntil        DateTime?     @db.Date
  placeOfSupplyCode String
  currency          String        @default("INR")
  subtotal          Decimal       @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(18, 2)
  total             Decimal       @default(0) @db.Decimal(18, 2)
  amountPaid        Decimal       @default(0) @db.Decimal(18, 2)
  paymentReceivedAt DateTime?
  billingSnapshot   Json
  shippingSnapshot  Json?
  terms             Json          @default("{}")
  issuedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organisation    Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  gstRegistration GSTRegistration       @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)
  party           Party                 @relation(fields: [partyId], references: [id], onDelete: Restrict)

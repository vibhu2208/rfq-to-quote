model CreditDebitNoteLine {
  id                String  @id @default(cuid())
  creditDebitNoteId String
  lineNumber        Int
  productId         String?
  description       String
  hsnCode           String?
  uqc               UqcCode
  quantity          Decimal @db.Decimal(18, 3)
  taxableValue      Decimal @db.Decimal(18, 2)
  taxRate           Decimal @db.Decimal(5, 2)
  cgstAmount        Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount        Decimal @default(0) @db.Decimal(18, 2)
  igstAmount        Decimal @default(0) @db.Decimal(18, 2)
  cessAmount        Decimal @default(0) @db.Decimal(18, 2)
  lineTotal         Decimal @db.Decimal(18, 2)

  note    CreditDebitNote @relation(fields: [creditDebitNoteId], references: [id], onDelete: Restrict)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([creditDebitNoteId, lineNumber])

  lines           ProformaInvoiceLine[]
  invoices        Invoice[]

  @@unique([gstRegistrationId, number])
  @@index([organisationId, issueDate])
  @@index([partyId, status])
}

model ProformaInvoiceLine {
  id                String  @id @default(cuid())
  proformaInvoiceId String
  lineNumber        Int
  productId         String?
  description       String
  hsnCode           String?
  uqc               UqcCode
  quantity          Decimal @db.Decimal(18, 3)
  unitPrice         Decimal @db.Decimal(18, 4)
  discountAmount    Decimal @default(0) @db.Decimal(18, 2)
  taxableValue      Decimal @db.Decimal(18, 2)
  taxRate           Decimal @db.Decimal(5, 2)
  cgstAmount        Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount        Decimal @default(0) @db.Decimal(18, 2)
  igstAmount        Decimal @default(0) @db.Decimal(18, 2)
  cessAmount        Decimal @default(0) @db.Decimal(18, 2)
  lineTotal         Decimal @db.Decimal(18, 2)

  proformaInvoice ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Restrict)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)


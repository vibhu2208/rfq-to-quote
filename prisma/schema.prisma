generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  UNDER_NEGOTIATION
  REVISED
  ACCEPTED
  REJECTED
  INVOICE_GENERATED
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  DELIVERED
  CLOSED
}

enum RfqChannel {
  WHATSAPP
  EMAIL
  WEB_FORM
  MARKETPLACE
  MANUAL
}

enum RfqStatus {
  NEW
  NEEDS_REVIEW
  PARSED
  QUOTED
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum VendorPreferredChannel {
  EMAIL
  WHATSAPP
}

enum VendorOutreachStatus {
  PENDING
  SENT
  REPLIED
  FAILED
}

enum QuoteReplyIntent {
  ACCEPT
  REJECT
  QUESTION
  COUNTER_OFFER
  REQUEST_REVISION
  ACKNOWLEDGEMENT
  UNCLEAR
}

enum KnowledgeSource {
  HUMAN_REPLY
  MANUAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      OrganisationMembership[]
  auditEvents      AuditEvent[]             @relation("AuditActor")
  knowledgeEntries KnowledgeEntry[]
  copilotChats     CopilotChat[]
}

model Product {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String
  description    String      @default("")
  unit           String      @default("pcs")
  uqc            UqcCode     @default(NOS)
  hsnCode        String?
  productType    ProductType @default(GOODS)
  organisationId String?
  basePrice      Decimal     @db.Decimal(12, 2)
  offerPrice     Decimal     @db.Decimal(12, 2)
  taxRate        Decimal     @default(18) @db.Decimal(5, 2)
  taxCategory    String      @default("GST18")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lineItems             QuoteLineItem[]
  organisation          Organisation?             @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  invoiceLines          InvoiceLine[]
  proformaLines         ProformaInvoiceLine[]
  noteLines             CreditDebitNoteLine[]
  stockMovements        StockMovement[]
  stockBalances         StockBalance[]
  valuationLayers       InventoryValuationLayer[]
  transactionDraftLines TransactionDraftLine[]

  @@index([name])
  @@index([active])
  @@index([organisationId])
  @@index([hsnCode])
}

model Rfq {
  id                   String     @id @default(cuid())
  channel              RfqChannel
  sourceRef            String     @default("") // message id / thread id
  subject              String     @default("")
  rawText              String     @default("")
  rawAttachments       Json       @default("[]") // [{ name, url?, contentType? }]
  customerName         String     @default("")
  customerPhone        String     @default("")
  customerEmail        String     @default("")
  customerCompany      String     @default("")
  status               RfqStatus  @default(NEW)
  parsedCategory       String?
  parsedSpecs          Json? // structured extraction from AI
  parseConfidence      Float?
  parseError           String?
  marketplacePrices    Json? // cached Amazon/Flipkart/IndiaMART snapshot
  marketplaceQuery     String? // search query used for the snapshot
  marketplaceFetchedAt DateTime?
  /** User-picked catalog products per requirement line (survives reload). */
  productSelections    Json?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  messages           RfqMessage[]
  quotes             Quote[]
  vendorPriceHistory VendorProductHistory[]
  vendorOutreaches   VendorOutreach[]

  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([sourceRef])
}

model RfqMessage {
  id        String           @id @default(cuid())
  rfqId     String
  direction MessageDirection
  channel   RfqChannel
  body      String           @default("")
  meta      Json             @default("{}") // provider ids, headers, etc.
  createdAt DateTime         @default(now())

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)
  version     Int         @default(1)
  rfqId       String?

  buyerName    String @default("")
  buyerCompany String @default("")
  buyerEmail   String @default("")
  buyerPhone   String @default("")
  buyerState   String @default("")
  buyerAddress String @default("")
  buyerGstin   String @default("")

  withGst         Boolean @default(true)
  gstMode         String  @default("AUTO") // AUTO | CGST_SGST | IGST
  subtotal        Decimal @default(0) @db.Decimal(14, 2)
  gstAmount       Decimal @default(0) @db.Decimal(14, 2)
  cgstAmount      Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount      Decimal @default(0) @db.Decimal(14, 2)
  igstAmount      Decimal @default(0) @db.Decimal(14, 2)
  otherTaxAmount  Decimal @default(0) @db.Decimal(14, 2)
  otherTaxLabel   String  @default("")
  deliveryCharge  Decimal @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  grandTotal      Decimal @default(0) @db.Decimal(14, 2)

  /// Flags for fields the user manually overrode so recalc does not clobber them
  manualOverrides Json @default("{}")

  notes      String    @default("")
  validUntil DateTime?
  sentAt     DateTime?

  /// Outbound Message-ID of the quote email (for In-Reply-To matching)
  outboundMsgId String @default("")
  /// Synthetic ref embedded in quote emails, e.g. QREF-Q-2026-0001
  threadRef     String @default("")

  needsAssistance     Boolean           @default(false)
  assistanceReason    String            @default("")
  lastBuyerReplyAt    DateTime?
  lastReplyIntent     QuoteReplyIntent?
  lastAnalysisSummary String            @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems        QuoteLineItem[]
  messages         QuoteMessage[]
  knowledgeEntries KnowledgeEntry[]
  rfq              Rfq?              @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  proformaInvoices ProformaInvoice[]

  @@index([status])
  @@index([createdAt])
  @@index([rfqId])
  @@index([outboundMsgId])
  @@index([threadRef])
  @@index([needsAssistance])
  @@index([buyerEmail])
}

model QuoteMessage {
  id          String            @id @default(cuid())
  quoteId     String
  direction   MessageDirection
  channel     RfqChannel        @default(EMAIL)
  subject     String            @default("")
  body        String            @default("")
  messageId   String            @default("")
  inReplyTo   String            @default("")
  fromEmail   String            @default("")
  toEmail     String            @default("")
  intent      QuoteReplyIntent?
  analysis    Json              @default("{}")
  autoReplied Boolean           @default(false)
  createdAt   DateTime          @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([messageId])
  @@index([createdAt])
  @@index([direction])
}

model KnowledgeEntry {
  id               String          @id @default(cuid())
  question         String
  answer           String
  tags             String[]        @default([])
  source           KnowledgeSource @default(HUMAN_REPLY)
  quoteId          String?
  inboundMessageId String          @default("")
  createdById      String?
  embedding        Json?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  quote     Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([quoteId])
  @@index([createdAt])
}

model CopilotChat {
  id        String   @id @default(cuid())
  userId    String?
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages CopilotChatMessage[]

  @@index([userId, updatedAt])
  @@index([updatedAt])
}

model CopilotChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  chat CopilotChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  description String  @default("")
  aliasName   String  @default("")
  qty         Decimal @default(1) @db.Decimal(12, 3)
  unit        String  @default("pcs")
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal @default(0) @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

model Vendor {
  id               String                 @id @default(cuid())
  name             String
  phone            String?
  email            String?
  whatsappId       String?
  preferredChannel VendorPreferredChannel @default(EMAIL)
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  categories     VendorCategory[]
  productHistory VendorProductHistory[]
  outreaches     VendorOutreach[]

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([active])
}

model VendorCategory {
  id          String @id @default(cuid())
  vendorId    String
  category    String
  subcategory String @default("")
  keywords    Json   @default("[]")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, category, subcategory])
  @@index([category])
  @@index([vendorId])
}

model VendorProductHistory {
  id           String   @id @default(cuid())
  vendorId     String
  productKey   String
  lastPrice    Decimal  @db.Decimal(14, 2)
  lastQuotedAt DateTime
  sourceRfqId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sourceRfq Rfq?   @relation(fields: [sourceRfqId], references: [id], onDelete: SetNull)

  @@unique([vendorId, productKey])
  @@index([productKey])
  @@index([vendorId])
  @@index([sourceRfqId])
  @@index([lastQuotedAt])
}

model VendorOutreach {
  id              String               @id @default(cuid())
  rfqId           String
  vendorId        String
  productKey      String               @default("")
  threadRef       String               @unique
  status          VendorOutreachStatus @default(PENDING)
  outboundSubject String               @default("")
  outboundBody    String               @default("")
  outboundMsgId   String               @default("")
  replyText       String               @default("")
  replyMsgId      String               @default("")
  quotedPrice     Decimal?             @db.Decimal(14, 2)
  sentAt          DateTime?
  repliedAt       DateTime?
  errorMessage    String               @default("")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  rfq    Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
  @@index([rfqId])
  @@index([vendorId])
  @@index([outboundMsgId])
  @@index([status])
}

model AppState {
  key       String   @id
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum LegalEntityType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  TRUST
  SOCIETY
  OTHER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum FiscalPeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
  LOCKED
}

enum DocumentType {
  QUOTATION
  PROFORMA_INVOICE
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  PAYMENT_RECEIPT
  JOURNAL_VOUCHER
  E_WAY_BILL
}

enum PartyType {
  CUSTOMER
  VENDOR
  BOTH
  EMPLOYEE
  GOVERNMENT
  OTHER
}

enum AddressType {
  BILLING
  SHIPPING
  REGISTERED
  WAREHOUSE
  OTHER
}

enum ProductType {
  GOODS
  SERVICE
}

enum UqcCode {
  BAG
  BAL
  BDL
  BKL
  BOU
  BOX
  BTL
  BUN
  CAN
  CBM
  CCM
  CMS
  CTN
  DOZ
  DRM
  GGR
  GMS
  GRS
  GYD
  KGS
  KLR
  KME
  LTR
  MLT
  MTR
  MTS
  NOS
  PAC
  PCS
  PRS
  QTL
  ROL
  SET
  SQF
  SQM
  SQY
  TBS
  TGM
  THD
  TON
  TUB
  UGS
  UNT
  YDS
  OTH
}

enum SourceDocumentType {
  RFQ
  PURCHASE_ORDER
  SALES_ORDER
  PROFORMA_INVOICE
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  BANK_STATEMENT
  PAYMENT_ADVICE
  GST_RETURN
  OTHER
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum DraftStatus {
  DRAFT
  VALIDATING
  NEEDS_REVIEW
  VALID
  POSTED
  REJECTED
  VOID
}

enum ValidationSeverity {
  INFO
  WARNING
  ERROR
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  VOID
}

enum NoteType {
  CREDIT
  DEBIT
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum InventoryValuationMethod {
  WEIGHTED_AVERAGE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
  VOID
}

enum PaymentDirection {
  RECEIPT
  PAYMENT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  DEMAND_DRAFT
  OTHER
}

enum PaymentStatus {
  DRAFT
  PENDING
  CLEARED
  BOUNCED
  CANCELLED
}

enum GstReturnType {
  GSTR1
  GSTR3B
  GSTR9
  GSTR9C
}

enum GstRecordStatus {
  DRAFT
  PREPARED
  VALIDATED
  FILED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum GstReconciliationStatus {
  UNMATCHED
  MATCHED
  PARTIAL
  MISMATCH
  RESOLVED
}

enum ExternalRecordStatus {
  PENDING
  GENERATED
  CANCELLED
  FAILED
  EXPIRED
}

model Organisation {
  id              String                   @id @default(cuid())
  code            String                   @unique
  name            String
  status          OrganisationStatus       @default(ACTIVE)
  baseCurrency    String                   @default("INR")
  timezone        String                   @default("Asia/Kolkata")
  inventoryPolicy InventoryValuationMethod @default(WEIGHTED_AVERAGE)
  policyMetadata  Json                     @default("{\"inventoryValuation\":\"WEIGHTED_AVERAGE\",\"negativeStockAllowed\":false}")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  legalEntities     LegalEntity[]
  memberships       OrganisationMembership[]
  roles             Role[]
  fiscalYears       FiscalYear[]
  documentSeries    DocumentSeries[]
  parties           Party[]
  products          Product[]
  warehouses        Warehouse[]
  auditEvents       AuditEvent[]
  sourceDocuments   SourceDocument[]
  transactionDrafts TransactionDraft[]
  proformaInvoices  ProformaInvoice[]
  invoices          Invoice[]
  creditDebitNotes  CreditDebitNote[]
  chartOfAccounts   ChartOfAccount[]
  journals          JournalEntry[]
  payments          Payment[]

  @@index([status])
}

model LegalEntity {
  id                String          @id @default(cuid())
  organisationId    String
  name              String
  legalName         String
  entityType        LegalEntityType
  pan               String?
  cin               String?
  tan               String?
  registeredAddress Json?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  gstRegistrations GSTRegistration[]
  fiscalYears      FiscalYear[]
  chartOfAccounts  ChartOfAccount[]
  journals         JournalEntry[]

  @@unique([organisationId, legalName])
  @@unique([organisationId, pan])
  @@index([organisationId, active])
}

model GSTRegistration {
  id               String    @id @default(cuid())
  legalEntityId    String
  gstin            String    @unique
  stateCode        String
  tradeName        String?
  registrationType String    @default("REGULAR")
  effectiveFrom    DateTime?
  cancelledAt      DateTime?
  filingFrequency  String    @default("MONTHLY")
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  legalEntity        LegalEntity         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  locations          BusinessLocation[]
  documentSeries     DocumentSeries[]
  parties            Party[]
  warehouses         Warehouse[]
  proformaInvoices   ProformaInvoice[]
  invoices           Invoice[]
  creditDebitNotes   CreditDebitNote[]
  stockMovements     StockMovement[]
  gstReturns         GstReturn[]
  gstReconciliations GstReconciliation[]
  eInvoiceRecords    EInvoiceRecord[]
  eWayBillRecords    EWayBillRecord[]

  @@index([legalEntityId, active])
  @@index([stateCode])
}

model BusinessLocation {
  id                String   @id @default(cuid())
  gstRegistrationId String
  code              String
  name              String
  addressLine1      String
  addressLine2      String?
  city              String
  district          String?
  state             String
  stateCode         String
  postalCode        String
  countryCode       String   @default("IN")
  isPrimary         Boolean  @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  gstRegistration GSTRegistration @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)
  warehouses      Warehouse[]

  @@unique([gstRegistrationId, code])
  @@index([gstRegistrationId, active])
}

model OrganisationMembership {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]

  @@unique([organisationId, userId])
  @@index([userId, status])
}

model Role {
  id             String   @id @default(cuid())
  organisationId String
  code           String
  name           String
  description    String   @default("")
  system         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships  MembershipRole[]
  permissions  RolePermission[]

  @@unique([organisationId, code])
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())

  membership OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  effect       PermissionEffect @default(ALLOW)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model FiscalYear {
  id             String    @id @default(cuid())
  organisationId String
  legalEntityId  String
  name           String
  startsOn       DateTime  @db.Date
  endsOn         DateTime  @db.Date
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  legalEntity  LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  periods      FiscalPeriod[]
  series       DocumentSeries[]
  journals     JournalEntry[]

  @@unique([legalEntityId, startsOn])
  @@index([organisationId, startsOn])
}

model FiscalPeriod {
  id           String             @id @default(cuid())
  fiscalYearId String
  number       Int
  name         String
  startsOn     DateTime           @db.Date
  endsOn       DateTime           @db.Date
  status       FiscalPeriodStatus @default(OPEN)
  lockedAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  journals   JournalEntry[]

  @@unique([fiscalYearId, number])
  @@index([fiscalYearId, status])
}

model DocumentSeries {
  id                String       @id @default(cuid())
  organisationId    String
  gstRegistrationId String?
  fiscalYearId      String?
  documentType      DocumentType
  code              String
  prefix            String       @default("")
  suffix            String       @default("")
  nextNumber        BigInt       @default(1)
  padding           Int          @default(4)
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organisation    Organisation               @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  gstRegistration GSTRegistration?           @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)
  fiscalYear      FiscalYear?                @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  allocations     DocumentNumberAllocation[]

  @@unique([organisationId, code])
  @@index([gstRegistrationId, documentType, active])
}

model DocumentNumberAllocation {
  id              String    @id @default(cuid())
  seriesId        String
  number          BigInt
  formattedNumber String
  idempotencyKey  String    @unique
  sourceType      String?
  sourceId        String?
  allocatedAt     DateTime  @default(now())
  committedAt     DateTime?
  voidedAt        DateTime?
  metadata        Json      @default("{}")

  series DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@unique([seriesId, number])
  @@unique([seriesId, formattedNumber])
  @@index([sourceType, sourceId])
}

model Party {
  id                String    @id @default(cuid())
  organisationId    String
  gstRegistrationId String?
  code              String
  type              PartyType
  legalName         String
  tradeName         String?
  gstin             String?
  pan               String?
  email             String?
  phone             String?
  placeOfSupplyCode String?
  gstinVerifiedAt   DateTime?
  gstinLegalName    String?
  gstinStatus       String?
  gstinRawResponse  Json?
  creditLimit       Decimal   @default(0) @db.Decimal(18, 2)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  gstRegistration   GSTRegistration?   @relation(fields: [gstRegistrationId], references: [id], onDelete: SetNull)
  addresses         Address[]
  proformaInvoices  ProformaInvoice[]
  invoices          Invoice[]
  creditDebitNotes  CreditDebitNote[]
  payments          Payment[]
  transactionDrafts TransactionDraft[]
  journalLines      JournalLine[]

  @@unique([organisationId, code])
  @@index([organisationId, legalName])
  @@index([gstin])
}

model Address {
  id           String      @id @default(cuid())
  partyId      String
  type         AddressType
  label        String      @default("")
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  state        String
  stateCode    String
  postalCode   String
  countryCode  String      @default("IN")
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId, type])
}

model Warehouse {
  id                 String                   @id @default(cuid())
  organisationId     String
  gstRegistrationId  String
  businessLocationId String?
  code               String
  name               String
  valuationMethod    InventoryValuationMethod @default(WEIGHTED_AVERAGE)
  policyMetadata     Json                     @default("{\"negativeStockAllowed\":false}")
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  organisation     Organisation              @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  gstRegistration  GSTRegistration           @relation(fields: [gstRegistrationId], references: [id], onDelete: Restrict)
  businessLocation BusinessLocation?         @relation(fields: [businessLocationId], references: [id], onDelete: SetNull)
  movements        StockMovement[]
  balances         StockBalance[]
